		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.3.0",
		"@types/pg": "^8.23.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"playwright": "^1.50.0"
	},
	"dependencies": {
		"@paddle/paddle-js": "^1.6.5",
