#!/bin/sh
# Architecture boundaries F-1…F-4 and F-6 (docs/architecture.md "Forbidden dependencies"), as greps.
# F-5 (only container.ts constructs adapters) is a review rule. Exit 1 on any violation.
set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT" || exit 1

# "file -> module" for every import / export-from / dynamic import in non-test sources under $1.
imports() {
  find "$1" -type f \( -name '*.ts' -o -name '*.svelte' \) ! -path '*/__tests__/*' -print |
    while IFS= read -r f; do
      grep -Eo "(from|import)[[:space:]]*\(?['\"][^'\"]+['\"]" "$f" |
        sed -E "s/.*['\"]([^'\"]+)['\"]$/\1/" |
        while IFS= read -r mod; do echo "$f -> $mod"; done
    done
}

# F-1: domain imports nothing outside its own context folder.
f1=$(imports src/lib/domain | grep -v -- "-> \./")
# F-2: application imports only domain, its own modules and node: stdlib.
f2=$(imports src/lib/application | grep -vE -- "-> (\./|\.\./|\\\$lib/domain/|\\\$lib/application|node:)")
# F-3: routes and hooks never reach into infrastructure — they go through the container.
f3=$(grep -rn "server/infrastructure" src/routes src/hooks.server.ts)
# F-4: only siteConfig.ts reads the environment.
# A stray src/.svelte-kit (generated by an ad-hoc vitest run) holds $env docs, not our code.
f4=$(grep -rnE "process\.env|import\.meta\.env|\\\$env/" src | grep -v -e '^src/lib/server/config/siteConfig.ts:' -e '^src/\.svelte-kit/')

# F-6: every Postgres pool/client comes from createPool (BUG-002: a bare pool crashes the process).
# Keyed on the import, not the call: only createPool.ts may value-import 'pg'; everyone else uses
# `import type`. That catches any alias or default-import name, and no unrelated Client class trips it.
f6=$(grep -rnE "from ['\"]pg['\"]" src --include='*.ts' | grep -v 'import type' | grep -v -e '^src/lib/server/infrastructure/pg/createPool.ts:' -e '/__tests__/')

bad=0
for rule in F-1 F-2 F-3 F-4 F-6; do
  case $rule in F-1) out=$f1 ;; F-2) out=$f2 ;; F-3) out=$f3 ;; F-4) out=$f4 ;; F-6) out=$f6 ;; esac
  [ -z "$out" ] && continue
  echo "$out" | sed "s/^/ARCH $rule: /"
  bad=1
done
[ "$bad" -eq 0 ] && echo "arch-check: F-1…F-4, F-6 hold"
exit "$bad"
