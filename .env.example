# All optional. Set SITE_URL in Coolify so canonical links and RSS point at your domain.
PORT=3000
SITE_URL=https://journey.example.com
ORIGIN=https://journey.example.com   # adapter-node CSRF origin — must match SITE_URL in production
SITE_NAME=Shopify App Build Journey
SITE_DESCRIPTION=Building a Shopify app in public.
AUTHOR=Cemal
CONTENT_DIR=content/posts
CACHE_TTL_MS=60000

# ── VIP / Paddle Billing ──────────────────────────────────────────────
# Client side (safe to expose): from Paddle → Developer tools → Authentication
PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxx
# Server side
PUBLIC_PADDLE_ENV=sandbox     # REQUIRED: sandbox | production. No default — /vip and the webhook refuse to run without it.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx   # Paddle → Notifications → your endpoint → secret key
PADDLE_API_KEY=pdl_sdbx_xxx   # server only: catalog script + customer portal sessions. Never reaches the client.

# ── Billing mirror + accounts (Postgres, e.g. Neon) ──────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"   # tables: see README "Database"
SESSION_SECRET=                # 32+ random chars: openssl rand -hex 32 — signs the login cookie
RESEND_API_KEY=                # optional; without it sign-in links are printed to the server log
EMAIL_FROM="Shopify App Build Journey <noreply@yourdomain.com>"
